# Database Configuration

# PostgreSQL Configuration (Default)
# Replace username, password, host, port and dbname with your PostgreSQL details
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/meetingsmart

# MySQL Configuration (Uncomment and use instead of PostgreSQL if needed)
# DATABASE_URL=mysql://root:password@localhost:3306/meetingsmart

# Optional: Individual DB config parameters for MySQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=meetingsmart

# Google Gemini API
# Required for AI features like summarization and task extraction
# Get your API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Session Configuration
# Used for secure cookie encryption - change this to a random string
SESSION_SECRET=your_random_secure_string

# Bot authentication key for /api/bot/* endpoints
BOT_API_KEY=replace_with_a_long_random_string

# Optional: OpenAI Configuration 
# Not required but can be used as an alternative to Gemini
# OPENAI_API_KEY=your_openai_api_key_here